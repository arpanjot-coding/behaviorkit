{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:behaviorkit:recording:1",
  "title": "BehaviorKit recording/1 manifest",
  "type": "object",
  "required": ["schema_version", "status", "kind", "implementation", "implementation_sha256", "inputs", "parameters", "cache_key", "artifacts", "created_unix"],
  "properties": {
    "schema_version": {"const": "recording/1"},
    "status": {"enum": ["running", "complete", "error"]},
    "kind": {"enum": ["candidates", "tracks", "rules"]},
    "implementation": {"type": "string"},
    "implementation_sha256": {"$ref": "#/$defs/digest"},
    "cache_key": {"$ref": "#/$defs/digest"},
    "inputs": {"type": "object"}, "parameters": {"type": "object"},
    "created_unix": {"type": "number", "minimum": 0},
    "artifacts": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["sha256", "bytes"], "additionalProperties": false,
      "properties": {"sha256": {"$ref": "#/$defs/digest"}, "bytes": {"type": "integer", "minimum": 0}}
    }},
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["classes", "confidence_floor", "stage", "pixels", "embeddings", "sample_fps", "max_detections"],
      "properties": {
        "classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "confidence_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "stage": {"enum": ["postprocessed_candidates", "tracked_observations"]},
        "pixels": {"type": "boolean"}, "embeddings": {"type": "boolean"},
        "sample_fps": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 120},
        "max_detections": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
