{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:behaviorkit:evaluation:1",
  "title": "BehaviorKit event annotations evaluation/1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "coverage"],
  "properties": {
    "schema_version": {"const": "evaluation/1"}, "split": {"type": "string"},
    "groups": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "coverage": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["source", "epoch", "start", "end"],
      "properties": {"source": {"type": "string"}, "epoch": {"type": "string"},
                     "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "minimum": 0}, "covered": {"type": "boolean"}}
    }},
    "events": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["source", "epoch", "rule", "start", "end"],
      "properties": {"source": {"type": "string"}, "epoch": {"type": "string"}, "rule": {"type": "string"},
                     "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "minimum": 0},
                     "eligible_at": {"type": "number", "minimum": 0}, "censored": {"type": "boolean"}}
    }},
    "counts": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["source", "epoch", "rule", "timestamp", "count"],
      "properties": {"source": {"type": "string"}, "epoch": {"type": "string"}, "rule": {"type": "string"},
                     "timestamp": {"type": "number", "minimum": 0}, "count": {"type": ["integer", "null"], "minimum": 0}}
    }}
  }
}
